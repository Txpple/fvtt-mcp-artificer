# Copy to .env (gitignored) and adjust for your machine.

# Headless ComfyUI API endpoint (see scripts/launch-comfyui.ps1)
COMFY_URL=http://127.0.0.1:8188

# The directory ComfyUI writes outputs to (its --output-directory). The server
# reads generated PNGs straight off this path and returns absolute file paths.
COMFY_OUTPUT_DIR=D:\Workbench\LOCAL\LocalAI\output

# Max milliseconds to wait for a single generation job (default 300000)
# ARTIFICER_TIMEOUT_MS=300000
