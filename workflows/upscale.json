{
  "1": {
    "class_type": "LoadImage",
    "_meta": { "title": "SUB: image (upload via /upload/image first)" },
    "inputs": { "image": "input.png" }
  },
  "2": {
    "class_type": "UpscaleModelLoader",
    "inputs": { "model_name": "4x-UltraSharp.safetensors" }
  },
  "3": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": { "upscale_model": ["2", 0], "image": ["1", 0] }
  },
  "4": {
    "class_type": "ImageScale",
    "_meta": { "title": "SUB: output width/height" },
    "inputs": {
      "image": ["3", 0],
      "upscale_method": "lanczos",
      "width": 2560,
      "height": 1600,
      "crop": "disabled"
    }
  },
  "5": {
    "class_type": "SaveImage",
    "_meta": { "title": "SUB: filename_prefix" },
    "inputs": { "images": ["4", 0], "filename_prefix": "upscaled" }
  }
}
