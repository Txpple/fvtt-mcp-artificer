{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "klein model" },
    "inputs": { "unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "klein text encoder" },
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "flux2" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "flux2 vae" },
    "inputs": { "vae_name": "flux2-vae.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "SUB: prompt" },
    "inputs": {
      "clip": ["2", 0],
      "text": "fantasy illustration, a torchlit smugglers' cove beneath sea cliffs, moored rowboats and stacked crates, moonlit surf, dramatic composition, adventure book art"
    }
  },
  "5": {
    "class_type": "EmptyFlux2LatentImage",
    "_meta": { "title": "SUB: width/height/batch" },
    "inputs": { "width": 1536, "height": 960, "batch_size": 6 }
  },
  "6": {
    "class_type": "RandomNoise",
    "_meta": { "title": "SUB: seed" },
    "inputs": { "noise_seed": 1 }
  },
  "7": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "8": {
    "class_type": "Flux2Scheduler",
    "_meta": { "title": "SUB: width/height (match node 5)" },
    "inputs": { "steps": 4, "width": 1536, "height": 960 }
  },
  "9": { "class_type": "BasicGuider", "inputs": { "model": ["1", 0], "conditioning": ["4", 0] } },
  "10": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["6", 0],
      "guider": ["9", 0],
      "sampler": ["7", 0],
      "sigmas": ["8", 0],
      "latent_image": ["5", 0]
    }
  },
  "11": { "class_type": "VAEDecode", "inputs": { "samples": ["10", 0], "vae": ["3", 0] } },
  "12": {
    "class_type": "SaveImage",
    "_meta": { "title": "SUB: filename_prefix" },
    "inputs": { "images": ["11", 0], "filename_prefix": "draft" }
  }
}
